{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm run \"/^dev:/\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint . --ignore-pattern \"web/**\" --ignore-pattern \".arch-selftest/**\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "auth generate --config scripts/auth-cli.config.ts --output src/infra/auth/schema.ts --yes && tsx scripts/auth-schema-postprocess.ts && prettier --write src/infra/auth/schema.ts",
    "db:migrate": "tsx src/migrate.ts",
    "new:module": "tsx scripts/new-module.ts"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "better-auth": "1.7.6",
    "bullmq": "6.3.10",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "rate-limit-redis": "6.0.1",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "auth": "1.7.6",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
