{
  "$id": "urn:watchpost:schema:monitor-settings",
  "title": "monitor-settings",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "intervalSeconds": {
      "default": 300,
      "type": "integer",
      "minimum": 15,
      "maximum": 86400
    },
    "timeoutMs": {
      "default": 10000,
      "type": "integer",
      "minimum": 1000,
      "maximum": 30000
    },
    "regions": {
      "default": [
        "eu-central",
        "us-east"
      ],
      "minItems": 1,
      "maxItems": 9,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "eu-central",
          "us-east",
          "ap-southeast",
          "ap-south",
          "me-central",
          "eu-west",
          "us-west",
          "sa-east",
          "ap-southeast-2"
        ]
      }
    },
    "minFailingRegions": {
      "default": 2,
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "alertOnRegionalIssue": {
      "default": false,
      "type": "boolean"
    },
    "recoverySuccesses": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "degradedLatencyMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    },
    "degradedAfterChecks": {
      "default": 3,
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "upsideDown": {
      "default": false,
      "type": "boolean"
    },
    "sloTarget": {
      "default": 99.9,
      "type": "number",
      "minimum": 90,
      "maximum": 99.999
    },
    "reminderMinutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 1440
    },
    "severity": {
      "default": "high",
      "type": "string",
      "enum": [
        "critical",
        "high",
        "low"
      ]
    },
    "tags": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "groupId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "parentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "alertPolicyId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "runbookUrl": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri"
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    },
    "publicName": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "name"
  ]
}
