{
  "$id": "urn:watchpost:schema:probe-hello-request",
  "title": "probe-hello-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "mode": {
      "type": "string",
      "enum": [
        "managed",
        "private"
      ]
    },
    "region": {
      "type": "string",
      "enum": [
        "eu-central",
        "us-east",
        "ap-southeast",
        "ap-south",
        "me-central",
        "eu-west",
        "us-west",
        "sa-east",
        "ap-southeast-2"
      ]
    },
    "capabilities": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "http",
          "tcp",
          "dns",
          "ping",
          "websocket",
          "tls"
        ]
      }
    }
  },
  "required": [
    "version",
    "mode",
    "region",
    "capabilities"
  ]
}
