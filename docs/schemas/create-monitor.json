        "intervalSeconds": {
          "default": 300,
          "type": "integer",
          "minimum": 15,
          "maximum": 86400
        },
        "timeoutMs": {
          "default": 10000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 30000
        },
        "regions": {
          "default": [
            "eu-central",
            "us-east"
          ],
          "minItems": 1,
          "maxItems": 9,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "eu-central",
                  "us-east",
                  "ap-southeast",
                  "ap-south",
                  "me-central",
                  "eu-west",
                  "us-west",
                  "sa-east",
                  "ap-southeast-2"
                ]
              },
              {
                "type": "string"
              }
