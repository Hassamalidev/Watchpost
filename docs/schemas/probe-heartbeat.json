{
  "$id": "urn:watchpost:schema:probe-heartbeat",
  "title": "probe-heartbeat",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "uptimeSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "assigned": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "inFlight": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "queueDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bufferedResults": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "loadAverage": {
      "type": "number",
      "minimum": 0
    },
    "errors": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    }
  },
  "required": [
    "version",
    "uptimeSeconds",
    "assigned",
    "inFlight",
    "queueDepth",
    "bufferedResults"
  ]
}
