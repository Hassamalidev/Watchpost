{
  "$id": "urn:watchpost:schema:create-channel",
  "title": "create-channel",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "email",
        "slack",
        "teams",
        "discord",
        "telegram",
        "webhook",
        "slack_webhook",
        "google_chat",
        "mattermost",
        "rocketchat",
        "zulip",
        "matrix",
        "pagerduty",
        "opsgenie",
        "splunk_oncall",
        "pushover",
        "pushbullet",
        "ntfy",
        "gotify",
        "sms",
        "voice"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "config": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "rules": {
      "type": "object",
      "properties": {
        "events": {
          "default": {
            "triggered": true,
            "acknowledged": true,
            "resolved": true,
            "reminder": true,
            "flapping": true
          },
          "type": "object",
          "properties": {
            "triggered": {
              "default": true,
              "type": "boolean"
            },
            "acknowledged": {
              "default": true,
              "type": "boolean"
            },
            "resolved": {
              "default": true,
              "type": "boolean"
            },
            "reminder": {
              "default": true,
              "type": "boolean"
            },
            "flapping": {
              "default": true,
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "minSeverity": {
          "default": "low",
          "type": "string",
          "enum": [
            "critical",
            "high",
            "low"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "name",
    "config"
  ],
  "additionalProperties": false
}
