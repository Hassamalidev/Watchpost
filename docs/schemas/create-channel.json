{
  "$id": "urn:watchpost:schema:create-channel",
  "title": "create-channel",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "email",
        "slack",
        "teams",
        "discord",
        "telegram",
        "webhook"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "config": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "type",
    "name",
    "config"
  ],
  "additionalProperties": false
}
