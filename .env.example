# Copy to .env and fill in. Never commit .env.
# Base variables (STACK.md §7)
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
TRUST_PROXY=loopback, linklocal, uniquelocal
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://watchpost:watchpost@localhost:5433/watchpost
REDIS_URL=redis://localhost:6379
# Comma-separated queues for this worker process; empty = all (PRODUCT.md §7.5)
WORKER_QUEUES=
# At least 32 characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# At least 32 characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public base URL of the API; links in auth emails point here
BETTER_AUTH_URL=http://localhost:4000
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=
TOKEN_ENC_KEY_ID=k1
# During rotation: retired keys that may still decrypt old values, as keyId:base64,keyId:base64
TOKEN_ENC_PREVIOUS_KEYS=
REVALIDATE_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Watchpost <alerts@mail.example.com>
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
ANTHROPIC_API_KEY=
SENTRY_DSN=

# Domains (PRODUCT.md Appendix A)
APP_DOMAIN=app.example.com
STATUS_BASE_DOMAIN=status.example.com
CUSTOM_DOMAIN_CNAME_TARGET=pages.example.com
# Public base of heartbeat ping URLs (hb.<domain> in production); empty = <BETTER_AUTH_URL>/api/hb
HEARTBEAT_BASE_URL=
CLOUDFLARE_API_TOKEN=

# Probes (API side)
REGIONS=eu-central,us-east,ap-southeast
PROBE_REGISTRATION_TOKEN=

# Probe container
API_URL=http://localhost:4000
# docker-compose's local probe (profile "probe") reaches the host API here
PROBE_API_URL=http://host.docker.internal:4000
PROBE_ID=
PROBE_SECRET=
PROBE_REGION=eu-central
PROBE_CONCURRENCY=200
# Local development only: CIDRs a managed probe may reach despite SSRF rules (e.g. the Docker network)
PROBE_ALLOW_CIDRS=
# Hostnames never checked (our own servers); the API host is always added
PROBE_DENY_HOSTS=

# Channels
# Local development only: private CIDRs the API may reach for webhooks (e.g. a local test receiver)
OUTBOUND_ALLOW_CIDRS=
EMAIL_TRANSPORT=console
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
TWILIO_VOICE_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_SECRET=
TEAMS_BOT_TENANT_ID=

# Security
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI
AI_ENABLED=true
AI_MONTHLY_BUDGET_USD_DEFAULT=5
# Upstream funding (PRODUCT.md §11): paying workspaces spend against their own payment. This caps
# what all free and trial workspaces together may cost us in AI per calendar month (0 = paid only).
UNFUNDED_AI_MONTHLY_CAP_USD=5
# Where warnings about our own provider balances go (Twilio short of what customers paid for)
OPS_EMAIL=

# Paddle price IDs (sandbox and live IDs differ); `pnpm --filter @app/api paddle:catalog` prints them
PADDLE_DISCOUNT_FOUNDING=
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_ANNUAL=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_ANNUAL=
PADDLE_PRICE_BUSINESS_MONTHLY=
PADDLE_PRICE_BUSINESS_ANNUAL=
PADDLE_PRICE_CREDITS_100=
PADDLE_PRICE_CREDITS_500=
PADDLE_PRICE_EXTRA_MONITORS_100=
PADDLE_PRICE_EXTRA_PROBE=
PADDLE_PRICE_EXTRA_CLIENT_WORKSPACE=

# Sentinel (runs on another provider)
SENTINEL_TARGETS=
SENTINEL_TELEGRAM_CHAT_ID=
SENTINEL_SMS_TO=

# Web push to browsers and installed apps (P4-T08). Make a pair with: pnpm --filter @app/api vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
